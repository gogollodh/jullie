#!/bin/sh
# Native pre-commit hook script
# Validates staged files for merge conflict markers and syntax errors.

set -u

TMP_DIR=$(mktemp -d)
TMP_LIST="${TMP_DIR}/staged_files.txt"
TMP_ERR="${TMP_DIR}/errors.txt"

# Ensure cleanup on exit
trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM

# Get list of staged files excluding deleted ones
git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR > "$TMP_LIST"

# If no staged files, exit successfully
if [ ! -s "$TMP_LIST" ]; then
    exit 0
fi

log_error() {
    file_path="$1"
    msg="$2"
    echo "  [ERROR] ${file_path}: ${msg}" >&2
    echo "error" >> "$TMP_ERR"
}

check_file() {
    file="$1"

    # Extract extension safely
    base="${file##*/}"
    case "$base" in
        *.*) ext="${base##*.}" ;;
        *) ext="tmp" ;;
    esac

    # Extract staged content from git index
    staged_file="${TMP_DIR}/check_${$}.${ext}"
    if ! git show ":$file" > "$staged_file" 2>/dev/null; then
        return 0
    fi

    # Skip empty files
    if [ ! -s "$staged_file" ]; then
        rm -f "$staged_file"
        return 0
    fi

    # 1. Check for unresolved merge conflict markers
    if grep -q -E '^(<<<<<<<|=======|>>>>>>>)' "$staged_file" 2>/dev/null; then
        log_error "$file" "Contains unresolved merge conflict markers."
    fi

    # 2. Extension-specific or shebang-based syntax checks
    case "$file" in
        *.sh|*.bash)
            if command -v sh >/dev/null 2>&1; then
                if ! sh -n "$staged_file" >/dev/null 2>&1; then
                    log_error "$file" "Shell syntax error detected."
                fi
            fi
            ;;
        *.py)
            if command -v python3 >/dev/null 2>&1; then
                if ! python3 -c "import ast, sys; ast.parse(open(sys.argv[1], 'rb').read())" "$staged_file" >/dev/null 2>&1; then
                    log_error "$file" "Python syntax error detected."
                fi
            fi
            ;;
        *.json)
            if command -v jq >/dev/null 2>&1; then
                if ! jq . "$staged_file" >/dev/null 2>&1; then
                    log_error "$file" "JSON syntax error detected."
                fi
            elif command -v python3 >/dev/null 2>&1; then
                if ! python3 -c "import json, sys; json.load(open(sys.argv[1]))" "$staged_file" >/dev/null 2>&1; then
                    log_error "$file" "JSON syntax error detected."
                fi
            fi
            ;;
        *.js|*.mjs|*.cjs|*.jsx)
            if command -v node >/dev/null 2>&1; then
                if ! node --check "$staged_file" >/dev/null 2>&1; then
                    log_error "$file" "JavaScript syntax error detected."
                fi
            fi
            ;;
        *.go)
            if command -v gofmt >/dev/null 2>&1; then
                if ! gofmt -e "$staged_file" >/dev/null 2>&1; then
                    log_error "$file" "Go syntax error detected."
                fi
            fi
            ;;
        *.rb)
            if command -v ruby >/dev/null 2>&1; then
                if ! ruby -c "$staged_file" >/dev/null 2>&1; then
                    log_error "$file" "Ruby syntax error detected."
                fi
            fi
            ;;
        *.php)
            if command -v php >/dev/null 2>&1; then
                if ! php -l "$staged_file" >/dev/null 2>&1; then
                    log_error "$file" "PHP syntax error detected."
                fi
            fi
            ;;
        *)
            # Check shebang for files without explicit extensions
            first_line=$(head -n 1 "$staged_file" 2>/dev/null || true)
            case "$first_line" in
                *sh|*sh\ *|*bash|*bash\ *)
                    if command -v sh >/dev/null 2>&1; then
                        if ! sh -n "$staged_file" >/dev/null 2>&1; then
                            log_error "$file" "Shell syntax error detected."
                        fi
                    fi
                    ;;
                *python|*python\ *|*python3|*python3\ *)
                    if command -v python3 >/dev/null 2>&1; then
                        if ! python3 -c "import ast, sys; ast.parse(open(sys.argv[1], 'rb').read())" "$staged_file" >/dev/null 2>&1; then
                            log_error "$file" "Python syntax error detected."
                        fi
                    fi
                    ;;
            esac
            ;;
    esac

    rm -f "$staged_file"
}

# Iterate through each staged file
while IFS= read -r file; do
    [ -z "$file" ] && continue
    check_file "$file"
done < "$TMP_LIST"

if [ -s "$TMP_ERR" ]; then
    echo "--------------------------------------------------------" >&2
    echo "Pre-commit check failed. Please fix the above errors." >&2
    echo "--------------------------------------------------------" >&2
    exit 1
fi

exit 0
